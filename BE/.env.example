# 실제 연결용 예시. 비어 있는 외부 발급 값은 임의의 정상 키로 만들 수 없다.
# scripts/configure.py가 첨부 키 파일을 읽어 실제 .env를 만든다.
APP_ENV=development
STORAGE_BACKEND=supabase
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_KEY
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.8-flash
DATA_PROVIDER=live
WORK24_AUTH_KEY=REPLACE_WITH_WORK24_KEY
ALIO_SERVICE_KEY=REPLACE_WITH_ALIO_KEY
# 발급된 ALIO 호출주소가 확인될 때까지 포털용 키를 별도로 입력한다. ALIO 키를 복사하지 않는다.
DATA_GOKR_SERVICE_KEY=
YOUTH_JOB_API_URL=https://apis.data.go.kr/1051000/recruitment/list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CACHE_TTL_SECONDS=21600
REQUEST_TIMEOUT_SECONDS=10
CPU_THRESHOLD=90
CPU_HIGH_SECONDS=5
ENABLE_DEMO_ITEMS=false
